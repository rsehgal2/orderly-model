{
  "name": "orderly",
  "version": "1.0.0",
  "description": "Conversational voice ordering agent for restaurants — Twilio + Deepgram + ElevenLabs + Claude, with real-time POS/KDS ticket sync and bilingual (EN/ES) call handling.",
  "main": "src/server.js",
  "type": "commonjs",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "mock-pos": "node src/pos/mockPos.js",
    "demo": "node scripts/demo-call.js",
    "demo:es": "node scripts/demo-call.js --scenario=spanish",
    "test": "node --test test/*.test.js"
  },
  "keywords": [
    "voice-agent",
    "twilio",
    "deepgram",
    "elevenlabs",
    "claude",
    "restaurant-pos",
    "conversational-ai"
  ],
  "author": "Rishab Sehgal",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "@deepgram/sdk": "^3.9.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "node-fetch": "^2.7.0",
    "twilio": "^5.3.4",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.7"
  }
}
